PORT=8000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:password@127.0.0.1:5432/soundgrid?schema=public

# Security Secrets (Dual-token Auth)
JWT_ACCESS_SECRET=your_jwt_access_super_secret_key_min_32_chars
JWT_REFRESH_SECRET=your_jwt_refresh_super_secret_key_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Microservice & External
AI_ENGINE_URL=http://127.0.0.1:8001
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
